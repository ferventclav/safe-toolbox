<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 app, unpackaged and self-contained, so the zip runs on a clean PC with nothing installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SafeToolbox</RootNamespace>
    <AssemblyName>SafeToolbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- One SafeToolbox.exe. WinUI's native DLLs and resources have to sit on disk, so .NET unpacks them once to
         %TEMP%\.net\SafeToolbox\<hash> on first launch; the cleaner's Guard keeps that folder. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinUI looks for resources.pri first and <exe name>.pri second, so this name keeps the XAML loading even
         when the exe is renamed (the installed copy is "Safe Toolbox.exe"). -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Program.cs owns Main so the exe can also run as the admin helpers and the background check, without UI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\smoke-test.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeToolbox.Core\SafeToolbox.Core.csproj" />
  </ItemGroup>

</Project>
