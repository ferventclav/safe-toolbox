    <RootNamespace>SafeToolbox.Core</RootNamespace>
    <AssemblyName>SafeToolbox.Core</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
