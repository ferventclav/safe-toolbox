  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeUpdater.Core\SafeUpdater.Core.csproj" />
    <ProjectReference Include="..\SafeDiskCleaner.Core\SafeDiskCleaner.Core.csproj" />
  </ItemGroup>

</Project>
